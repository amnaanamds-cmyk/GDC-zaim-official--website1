# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# `npm run setup` creates this file for you and fills in the password.
DATABASE_URL="postgresql://gdc:CHANGE_ME@127.0.0.1:5432/gdc_zaim?schema=public"

SESSION_COOKIE_NAME="gdc_session"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Hosting (Vercel, Railway, Render …) — set these in the platform dashboard,
# not in this file.
# ---------------------------------------------------------------------------
# DATABASE_URL          the hosted PostgreSQL connection string (Neon, Supabase,
#                       Vercel Postgres). Use the *pooled* connection string.
#
# BLOB_READ_WRITE_TOKEN created automatically when you add a Vercel Blob store.
#                       Without it, uploads are written to public/uploads on
#                       local disk — fine on a laptop, wiped on every deploy on
#                       a hosting platform.
