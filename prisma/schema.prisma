// Government Degree College Zaim — Website & Management Portal
// Data layer for the SRS modules. One schema, one source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ *
 * Accounts, sessions, audit  (SRS §25 Security, §5 Admin panel)
 * ------------------------------------------------------------------ */
enum Role {
  ADMIN
  TEACHER
  STUDENT
  LIBRARIAN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  name          String
  role          Role
  active        Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  teacher           Faculty?
  student           Student?
  notices           Notice[]          @relation("NoticeAuthor")
  uploads           EventMedia[]
  activity          ActivityLog[]
  marksSubmitted    Mark[]            @relation("MarkSubmittedBy")
  marksVerified     Mark[]            @relation("MarkVerifiedBy")
  attendanceMarked  AttendanceRecord[]
  siteImages        SiteImage[]
  documents         Download[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/* ------------------------------------------------------------------ *
 * Academic structure  (SRS §1, §9, §10)
 * ------------------------------------------------------------------ */
model Department {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  nameUr          String
  icon            String
  intro           String
  hodName         String
  hodDesignation  String
  established     Int
  email           String
  courseTitles    String[]
  facilities      String[]
  achievements    String[]
  studentCount    Int      @default(0)
  facultyCount    Int      @default(0)
  order           Int      @default(0)

  faculty     Faculty[]
  programmes  Programme[]
  courses     Course[]
  notices     Notice[]
  complaints  Complaint[]
}

model Faculty {
  id             String      @id @default(cuid())
  name           String
  designation    String
  qualification  String
  specialization String
  email          String      @unique
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId         String?     @unique
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order          Int         @default(0)

  courses Course[]
}

model Programme {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  level        String
  duration     String
  seats        Int
  eligibility  String
  fee          String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  students     Student[]
  applications Application[]
}

model Course {
  id           String     @id @default(cuid())
  code         String     @unique
  title        String
  creditHours  Int        @default(3)
  semester     Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      Faculty?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  enrollments Enrollment[]
}

model Student {
  id          String    @id @default(cuid())
  regNo       String    @unique
  name        String
  semester    Int
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  duesCleared Boolean   @default(true)

  enrollments Enrollment[]
}

model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester  Int
  session   String  @default("Fall 2026")

  attendance AttendanceRecord[]
  mark       Mark?

  @@unique([studentId, courseId, session])
}

/* ------------------------------------------------------------------ *
 * Attendance and results  (SRS §7, §8)
 * ------------------------------------------------------------------ */
enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  markedById   String?
  markedBy     User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@unique([enrollmentId, date])
  @@index([date])
}

enum MarkStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

model Mark {
  id            String     @id @default(cuid())
  enrollmentId  String     @unique
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessional     Float?
  midterm       Float?
  finalExam     Float?
  status        MarkStatus @default(DRAFT)
  submittedById String?
  submittedBy   User?      @relation("MarkSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  verifiedById  String?
  verifiedBy    User?      @relation("MarkVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime   @updatedAt
}

/* ------------------------------------------------------------------ *
 * Notices and events  (SRS §6, §15)
 * ------------------------------------------------------------------ */
model Notice {
  id           String      @id @default(cuid())
  title        String
  titleUr      String?
  body         String
  category     String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  audience     String      @default("ALL")
  pinned       Boolean     @default(false)
  publishAt    DateTime    @default(now())
  expiresAt    DateTime?
  fileUrl      String?
  fileName     String?
  authorId     String?
  author       User?       @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([publishAt])
}

model Event {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  summary          String
  date             DateTime @db.Date
  time             String
  venue            String
  category         String
  registrationOpen Boolean  @default(true)
  createdAt        DateTime @default(now())

  media         EventMedia[]
  registrations EventRegistration[]
}

enum MediaKind {
  IMAGE
  VIDEO
}

/// Photographs and videos of college events, uploaded by an administrator
/// from their local drive and served to every visitor.
model EventMedia {
  id           String    @id @default(cuid())
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind         MediaKind
  title        String
  description  String
  filePath     String
  posterPath   String?
  mime         String
  size         Int
  duration     Float?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([eventId])
}

model EventRegistration {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentName String
  regNo       String
  createdAt   DateTime @default(now())
}

/* ------------------------------------------------------------------ *
 * Library, documents, scholarships  (SRS §10, §12, §21)
 * ------------------------------------------------------------------ */
model Book {
  id        String @id @default(cuid())
  title     String
  author    String
  isbn      String @unique
  category  String
  copies    Int
  available Int
  shelf     String
}

model Download {
  id          String   @id @default(cuid())
  title       String
  category    String
  fileType    String   @default("PDF")
  size        String
  filePath    String?
  mime        String?
  bytes       Int      @default(0)
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  publishedAt DateTime @default(now())
}

model Scholarship {
  id          String    @id @default(cuid())
  name        String
  provider    String
  covers      String
  eligibility String
  deadline    DateTime?
  deadlineNote String?
}

/* ------------------------------------------------------------------ *
 * Student-facing workflows  (SRS §2, §13, §14)
 * ------------------------------------------------------------------ */
enum RequestStage {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  READY
  DELIVERED
}

model ServiceRequest {
  id          String       @id @default(cuid())
  ref         String       @unique
  studentName String
  regNo       String
  serviceType String
  purpose     String
  contact     String
  stage       RequestStage @default(SUBMITTED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
}

model Complaint {
  id           String          @id @default(cuid())
  ref          String          @unique
  category     String
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  details      String
  contact      String?
  status       ComplaintStatus @default(SUBMITTED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model Application {
  id          String            @id @default(cuid())
  ref         String            @unique
  name        String
  /// Parent or guardian. Not every country records a father's name.
  guardianName String
  /// National identity or birth-registration number, in whatever form the
  /// applicant's country issues it — never validated against one format.
  idNumber    String
  dob         DateTime          @db.Date
  phone       String
  email       String?
  programmeId String
  programme   Programme         @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  marks       Int
  /// The total the marks are out of, as stated by the applicant, because
  /// qualifying examinations are not marked out of the same number everywhere.
  totalMarks  Int               @default(100)
  address     String
  meritScore  Float?
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now())

  documents ApplicationDocument[]
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  filePath      String
  originalName  String
  mime          String
  size          Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/* ------------------------------------------------------------------ *
 * Site content  (SRS §1, §16, §17, §20)
 * ------------------------------------------------------------------ */
model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  imagePath String?
  tone      String   @default("a")
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// The college this deployment belongs to — exactly one row, id "institution".
///
/// Everything that names or describes the institution lives here rather than in
/// the code, so a copy of this repository can be set up for a different college
/// entirely from the browser, without editing a single file. The first-run
/// wizard at /setup creates this row; the administrator edits it afterwards.
model Institution {
  id String @id @default("institution")

  /* Identity */
  name         String
  nameUr       String
  shortName    String
  shortNameUr  String
  department   String @default("Higher Education Department")
  departmentUr String @default("محکمہ اعلیٰ تعلیم")
  established  Int
  affiliation  String
  crestPath    String?

  /* Where and how to reach it */
  address         String
  addressUr       String @default("")
  district        String
  phone           String
  admissionsPhone String
  email           String
  admissionsEmail String
  officeHours     String @default("Monday – Friday, 08:00 – 14:00")

  /* The head of the institution */
  principalName          String
  principalDesignation   String @default("Principal")
  principalQualification String @default("")
  /// Blank line separated paragraphs; the home page shows the first two.
  principalMessage       String @default("")

  /* Narrative shown on the home and about pages. Blank-line separated. */
  tagline     String @default("")
  taglineUr   String @default("")
  aboutLead   String @default("")
  historyBody String @default("")

  setupCompletedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

/// A member of the college leadership, shown on the About page.
/// The administrator edits the details and uploads the portrait — the
/// principal's photograph included — from Admin -> Website content.
model Leader {
  id        String   @id @default(cuid())
  role      String
  name      String
  detail    String
  icon      String   @default("user")
  photoPath String?
  alt       String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A photograph filling a fixed slot in the site design: the banner behind
/// the home page hero, the campus photograph on the About page. Keyed by
/// slot, so uploading a new one replaces the old in place and every page
/// using that slot changes at once.
model SiteImage {
  slot        String   @id
  imagePath   String
  alt         String   @default("")
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Facility {
  id     String @id @default(cuid())
  name   String
  icon   String
  detail String
  order  Int    @default(0)
}

model Alumnus {
  id    String @id @default(cuid())
  name  String
  batch String
  role  String
  order Int    @default(0)
}

model CareerOpportunity {
  id       String    @id @default(cuid())
  title    String
  org      String
  type     String
  deadline DateTime?
}

model AdmissionStage {
  id     String @id @default(cuid())
  stage  String
  dates  String
  status String
  order  Int    @default(0)
}
