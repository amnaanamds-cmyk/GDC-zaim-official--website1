# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the real one holds the database password; the example is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime uploads (event photos/videos, admission documents) belong on the
# server's disk or object storage, not in the repository.
/public/uploads/*
!/public/uploads/.gitkeep

# Files uploaded from the admin panel while the site is running. They cannot
# live under public/ — Next.js snapshots that folder at build time.
/var/
